//KQL detection rule for failed ssh auth attempts. Needs work
Syslog
| where TimeGenerated >= ago(10m)
| where ProcessName == "sshd"
| where SyslogMessage has_any("Failed password", "Invalid user", "authentication failure", "Failed publickey")
| extend SourceIP = extract(@"from\s+(\d{1,3}(?:\.\d{1,3}){3})", 1, SyslogMessage)
| extend TargetUser = extract(@"(?:for|user)\s+(?:invalid user\s+)?(\S+)", 1, SyslogMessage)
| summarize
    FailedAttempts = count(),
    AttemptedUsers = make_set(TargetUser, 20),
    FailureMessages = make_set(SyslogMessage, 10),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by Computer, SourceIP
| where FailedAttempts >= 5
| project
    LastAttempt,
    Computer,
    SourceIP,
    FailedAttempts,
    AttemptedUsers,
    FailureMessages,
    FirstAttempt
| order by FailedAttempts desc